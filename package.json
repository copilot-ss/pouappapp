{
  "name": "bubblesapp",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "set EXPO_NO_DEV_TOOLS=1 && expo start -c",
    "android": "expo run:android",
    "start:dev": "set EXPO_NO_DEV_TOOLS=1 && expo start --dev-client -c --android",
    "start:dev:tunnel": "set EXPO_NO_DEV_TOOLS=1 && expo start --dev-client -c --tunnel",
    "start:tunnel": "set EXPO_NO_DEV_TOOLS=1 && expo start -c --tunnel",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "54.0.7",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-speech": "~14.0.7",
    "expo-status-bar": "~3.0.8",
    "lottie-react-native": "~7.3.1",
    "react-native-url-polyfill": "^2.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "expo-dev-client": "~6.0.12",
    "react-native-get-random-values": "^1.11.0",
    "expo-clipboard": "~8.0.7",
    "expo-av": "~16.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "babel-preset-expo": "^54.0.0",
    "nativewind": "^4.1.23",
    "tailwindcss": "^3.4.17"
  },
  "private": true
}
